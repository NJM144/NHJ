{
  admin off
}

:{$PORT} {
  root * /app/dist
  try_files {path} /index.html
  file_server

  # Proxy les appels front → API publique (ne rien strip, on garde /api/…)
  @api path /api*
  handle @api {
    // Prod : URL relative (via proxy Caddy). Dev : .env local peut surcharger.
const API_BASE = (import.meta.env.VITE_API_BASE ?? '').replace(/\/$/, '');

    reverse_proxy {$API_ORIGIN}
  }
}
